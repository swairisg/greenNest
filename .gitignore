coverage/

# Builds / artifacts (frontends, bundles, etc.)
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
.vscode/

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
